set shell := ["bash", "-euo", "pipefail", "-c"]

python := ".venv/bin/python"

default:
    @just --list

# Interaktywne sesje agentów
agent-setup:
    bash setup/install-agent-profiles.sh

agent-doctor:
    bash scripts/agent/doctor.sh

skills-check:
    {{ python }} scripts/agent/validate_skills.py

claude *args:
    bash scripts/agent/claude-interactive.sh {{ args }}

codex *args:
    bash scripts/agent/codex-interactive.sh {{ args }}

codex-read *args:
    bash scripts/agent/codex-interactive.sh --read-only -- {{ args }}

codex-ship *args:
    bash scripts/agent/codex-interactive.sh --ship -- {{ args }}

handoff:
    {{ python }} scripts/agent/checkpoint.py

# Wspólne API deterministycznego pipeline'u
test *args:
    {{ python }} -m pytest {{ args }}

# Warstwy testów — pełny opis w README, sekcja „Testy: kontrakt kodu vs. realne środowisko”.
# Sam kontrakt kodu: szybka pętla edycja-test, bez zależności od maszyny.
test-fast *args:
    {{ python }} -m pytest -m "not environment and not cli_contract and not probe and not e2e" {{ args }}

# Realne środowisko (biblioteki + binarki), bez atrap.
env-check *args:
    {{ python }} -m pytest -m environment {{ args }}

# Argv backendów AI konfrontowane z parserem prawdziwych CLI (bez promptów, bez kosztu).
cli-check *args:
    {{ python }} -m pytest -m cli_contract {{ args }}

# Czy testy w ogóle coś łapią: psuje KOPIĘ repo i sprawdza, czy robi się czerwono.
# Zapisane kontrakty z audytu 2026-09-18; każdy MUSI wyjść jako WYKRYTE.
mutate-check *args:
    {{ python }} scripts/agent/mutate.py check {{ args }}

# Pojedyncza mutacja z pliku specyfikacji (tests/mutations/*.yaml).
mutate spec:
    {{ python }} scripts/agent/mutate.py one {{ spec }}

# Kontrola STANU (nie kodu): spójność operacyjnego indeksu.
index-check *args:
    {{ python }} scripts/doctor.py index {{ args }}

# Kontrola STANU: czy źródła są nadal takie, jakie zapisał skan (reguła twarda nr 1).
sources-check *args:
    {{ python }} scripts/doctor.py sources {{ args }}

# Pełny łańcuch etapów na syntetycznej paczce (styki między skryptami).
e2e *args:
    {{ python }} -m pytest -m e2e {{ args }}

# Sondy na realnych danych lokalnych (target_repo, źródła) — tylko odczyt.
probe *args:
    {{ python }} -m pytest -m probe {{ args }}

db-init:
    {{ python }} scripts/db_admin.py init

scan *args:
    {{ python }} scripts/scan.py {{ args }}

hash *args:
    {{ python }} scripts/hash_files.py {{ args }}

fold-hash *args:
    {{ python }} scripts/fold_hash.py {{ args }}

dedup-report *args:
    {{ python }} scripts/dedup_report.py {{ args }}

scan-target *args:
    {{ python }} scripts/scan_target.py {{ args }}

# B2: głowa tekstu + podpisy podobieństwa dla treści w statusie 'hashed'.
extract *args:
    {{ python }} scripts/extract_text.py {{ args }}

llm task prompt_file *args:
    {{ python }} scripts/llm_client.py --task {{ task }} --prompt-file {{ prompt_file }} {{ args }}

# B1: wycinek indeksu jednego przedmiotu, bez zmian materiałów.
subject-prepare semester skrot *args:
    {{ python }} scripts/prepare_subject.py --semester {{ semester }} --skrot {{ skrot }} {{ args }}

# B3: klasyfikacja deterministyczna + heurystyka. Zero kosztu AI, zero zmian w bazie.
# Wynik: plan.det.jsonl (decyzje) i unresolved.jsonl (to, co idzie do B5) obok manifestu.
subject-classify semester skrot *args:
    {{ python }} scripts/classify.py --semester {{ semester }} --skrot {{ skrot }} {{ args }}

# B6: podobieństwo treści -> tabela `relations` + eksport relations.jsonl.
# Wymaga podpisów z etapu extract (just extract). Nigdy nie kasuje materiałów.
subject-relate semester skrot *args:
    {{ python }} scripts/near_dupe.py --semester {{ semester }} --skrot {{ skrot }} {{ args }}

# B5: resztki po klasyfikacji deterministycznej idą do modelu z thresholds.yaml: llm
# (domyślnie codex_cli = limit ChatGPT, nie limit koordynatora). Wznawialne.
subject-ai-resolve semester skrot *args:
    {{ python }} scripts/ai_resolve.py --semester {{ semester }} --skrot {{ skrot }} {{ args }}

# B7: scalenie decyzji w jeden plan.jsonl (+ zapis do bazy, JSONL jest eksportem).
subject-plan semester skrot *args:
    {{ python }} scripts/build_plan.py --semester {{ semester }} --skrot {{ skrot }} {{ args }}

# B14: zapis ręcznej decyzji z review. Studio (S1) używa tej samej biblioteki.
subject-decide *args:
    {{ python }} scripts/manual_decisions.py {{ args }}

# Stabilne nazwy dalszych etapów — czekają na skrypty z TODO B9-B14.

# B8: bramka przed apply. Kod wyjścia 2 = planu NIE WOLNO wykonać.
subject-validate semester skrot *args:
    {{ python }} scripts/validate_plan.py --semester {{ semester }} --skrot {{ skrot }} {{ args }}

# B9: strona przeglądu dla człowieka (diff near-dupe, miniatury, unresolved).
subject-review semester skrot *args:
    {{ python }} scripts/review_report.py --semester {{ semester }} --skrot {{ skrot }} {{ args }}

# C3: vault dla synapse (semestr -> przedmiot -> plik) z indeksu; bez gita.
synapse *args:
    {{ python }} scripts/synapse_export.py {{ args }}

# C3: nasz vault przepuszczony przez PRAWDZIWY generator (studio/graf).
vendor-check *args:
    {{ python }} -m pytest -m vendor {{ args }}

# C3: eksport + generator + notatki dla viewera (tryb samodzielny, bez studia).
# graph.json, search-index.json i public/vault/ w studio/graf to ARTEFAKTY BUILDU —
# ignorowane w gicie; nasze dane grafu dla studia idą do 20_WORK/synapse/.
synapse-view *args:
    {{ python }} scripts/synapse_export.py {{ args }}
    dotnet run --project studio/graf/Synapse.Generator/Synapse.Generator \
      -c Release --nologo -- \
      --vault ../../20_WORK/synapse/vault \
      --out studio/graf/synapse-viewer/public/graph.json \
      --no-git
    rsync -a --delete --prune-empty-dirs \
      --include='*/' --include='*.md' --exclude='*' \
      ../../20_WORK/synapse/vault/ studio/graf/synapse-viewer/public/vault/
    @echo "podglad: cd studio/graf/synapse-viewer && npm run dev"

# E3: przedmioty x etapy liczone z indeksu -> reports/STATUS.md.
status *args:
    {{ python }} scripts/status_report.py {{ args }}

# B10: wykonanie ZAAKCEPTOWANEGO planu. Domyślnie dry-run — kopiuje dopiero z --yes,
# najlepiej z --expect-hash <odcisk planu>, bo zgoda dotyczy konkretnego planu.
# Bramka B8 jest wykonywana ponownie tutaj: plan odrzucony = kod 2 i zero kopii.
subject-apply semester skrot *args:
    {{ python }} scripts/apply.py --semester {{ semester }} --skrot {{ skrot }} {{ args }}

# B11: hash po kopii wobec planu + kontrola drzewa. Kod 2 = NIE commituj materiałów.
subject-verify semester skrot *args:
    {{ python }} scripts/verify.py --semester {{ semester }} --skrot {{ skrot }} {{ args }}

# S0: studio — lokalny warsztat nad indeksem (studio/PLAN.md). Faza S0 jest TYLKO
# do odczytu, a serwer nasłuchuje wyłącznie na 127.0.0.1 (adres spoza pętli
# zwrotnej = odmowa startu, kod 2). Serwuje zbudowany front z studio/web/dist.
studio *args:
    {{ python }} -m studio.api {{ args }}

# Praca nad widokiem: backend z przeładowaniem + Vite z proxy na /api.
# Wszystko w JEDNEJ linii, bo każda linia recepty to osobna powłoka — inaczej
# trap nie posprzątałby backendu po zamknięciu Vite. `setsid` daje backendowi
# własną grupę procesów, więc trap ubija też podproces przeładowywania uvicorna
# (sam TERM na rodzica go nie zatrzymuje — sprawdzone).
studio-dev port="8765" web_port="5173":
    [ -d studio/web/node_modules ] || npm --prefix studio/web install; setsid {{ python }} -m studio.api --reload --port {{ port }} & API=$!; trap 'kill -TERM -$API 2>/dev/null || kill -TERM $API 2>/dev/null || true' EXIT INT TERM; PACZKA_STUDIO_API=http://127.0.0.1:{{ port }} npm --prefix studio/web run dev -- --port {{ web_port }} --strictPort

# Syntetyczna baza demo (studio bez prawdziwych materiałów).
studio-seed *args:
    {{ python }} -m studio.seed_demo {{ args }}

# S4.1: graf jako soczewka studia — vault z indeksu, generator, viewer pod /graf.
# Źródła grafu (generator .NET + viewer Svelte) są w repo: `studio/graf/`.
# Viewer budujemy z `--base=/graf/`, bo studio serwuje go pod tym prefiksem;
# `/graph.json` i `/vault/...` zostają bezwzględne i wystawia je backend studia.
# Wymaga toolchainu .NET (generator) i node (viewer).
studio-graf *args:
    {{ python }} scripts/synapse_export.py {{ args }}
    dotnet run --project studio/graf/Synapse.Generator/Synapse.Generator \
      -c Release --nologo -- \
      --vault ../../20_WORK/synapse/vault \
      --out ../../20_WORK/synapse/graph.json \
      --no-git
    [ -d studio/graf/synapse-viewer/node_modules ] || npm --prefix studio/graf/synapse-viewer install
    npm --prefix studio/graf/synapse-viewer run build -- --base=/graf/
    @echo "graf gotowy: http://127.0.0.1:8765/graf/ (albo zakładka „graf” w studiu)"

# Front do postaci, którą serwuje `just studio`.
studio-build:
    [ -d studio/web/node_modules ] || npm --prefix studio/web install
    npm --prefix studio/web run build
