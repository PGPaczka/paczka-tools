#     header @vite_assets Cache-Control "max-age=31536000, immutable"
#
#     file_server
#     try_files {path} /index.html
#
#     # Caddy auto-HTTPS: obtains and renews a cert automatically.
#     # Requires the hostname to be publicly resolvable, or configure
#     # tls with an internal CA / DNS challenge for private hostnames.
# }
